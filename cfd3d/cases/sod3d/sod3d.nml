&cfd3d
  mesh_file       = 'sod3d.msh'
  case_name       = 'sod3d'
  output_dir      = '.'
  t_end           = 0.2
  cfl             = 0.5
  max_steps       = 100000
  output_interval = 0.05

  init_type      = 'riemann'
  diaphragm_axis = 1
  diaphragm_pos  = 0.5
  rho_L = 1.0
  u_L   = 0.0
  v_L   = 0.0
  w_L   = 0.0
  p_L   = 1.0
  rho_R = 0.125
  u_R   = 0.0
  v_R   = 0.0
  w_R   = 0.0
  p_R   = 0.1

  patch_count   = 6
  patch_name(1) = 'x_min'
  patch_bc(1)   = 'slip_wall'
  patch_name(2) = 'x_max'
  patch_bc(2)   = 'slip_wall'
  patch_name(3) = 'y_min'
  patch_bc(3)   = 'slip_wall'
  patch_name(4) = 'y_max'
  patch_bc(4)   = 'slip_wall'
  patch_name(5) = 'z_min'
  patch_bc(5)   = 'slip_wall'
  patch_name(6) = 'z_max'
  patch_bc(6)   = 'slip_wall'
/
