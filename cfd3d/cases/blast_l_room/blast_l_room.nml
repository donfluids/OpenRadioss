&cfd3d
  mesh_file       = 'blast_l_room.msh'
  case_name       = 'blast_l_room'
  output_dir      = '.'
  t_end           = 2.5e-3
  cfl             = 0.4
  max_steps       = 20000
  output_interval = 2.5e-3

  ! 5 g TNT-equivalent charge in the far end of the top arm of the L.
  ! (Top arm = x in [0, 0.5], y in [0.5, 1.0].)
  init_type       = 'tnt_charge'
  blast_center    = 0.250, 0.800, 0.500
  blast_radius    = 0.080
  tnt_mass        = 0.005
  tnt_specific_E  = 4.184e6
  ambient_rho     = 1.225
  ambient_p       = 101325.0
  R_gas           = 287.05

  muscl_enabled   = .true.
  venkat_K        = 5.0
  viscous_enabled = .false.

  probes_file     = 'probes.csv'

  patch_count   = 3
  patch_name(1) = 'walls'
  patch_bc(1)   = 'slip_wall'
  patch_name(2) = 'vent_outside'
  patch_bc(2)   = 'farfield'
  patch_name(3) = 'obstacle_faces'
  patch_bc(3)   = 'slip_wall'
/
