&cfd3d
  mesh_file       = 'cut_cell_box.msh'
  case_name       = 'cut_cell_cyl'
  output_dir      = '.'
  t_end           = 6.0e-4
  cfl             = 0.4
  max_steps       = 4000
  output_interval = 6.0e-4

  ! Closed 1 m^3 box with a z-aligned cylinder obstacle: axis through
  ! (0.5,0.5), radius 0.15 m, spanning z in [0.2, 0.8] (a finite column).
  ! Curved lateral surface + flat end caps exercise both the sampled
  ! side-wall closure fragment and the cap face blockage.
  init_type       = 'tnt_charge'
  blast_center    = 0.22, 0.5, 0.5
  blast_radius    = 0.07
  tnt_mass        = 0.002
  tnt_specific_E  = 4.184e6
  ambient_rho     = 1.225
  ambient_p       = 101325.0
  R_gas           = 287.05

  muscl_enabled   = .true.
  venkat_K        = 5.0
  viscous_enabled = .false.

  ! One z-aligned cylinder: kind=4, params = (cx, cy, -, radius, z_lo, z_hi)
  n_shapes        = 1
  shape_kind(1)   = 4
  shape_param(:,1) = 0.5, 0.5, 0.0, 0.15, 0.2, 0.8

  patch_count   = 6
  patch_name(1) = 'x_min'
  patch_bc(1)   = 'slip_wall'
  patch_name(2) = 'x_max'
  patch_bc(2)   = 'slip_wall'
  patch_name(3) = 'y_min'
  patch_bc(3)   = 'slip_wall'
  patch_name(4) = 'y_max'
  patch_bc(4)   = 'slip_wall'
  patch_name(5) = 'z_min'
  patch_bc(5)   = 'slip_wall'
  patch_name(6) = 'z_max'
  patch_bc(6)   = 'slip_wall'
/
