&cfd3d
  mesh_file       = 'cut_cell_box.msh'
  case_name       = 'cut_cell_sphere'
  output_dir      = '.'
  t_end           = 6.0e-4
  cfl             = 0.4
  max_steps       = 4000
  output_interval = 6.0e-4

  ! Closed 1 m^3 box (all six faces slip walls) with a single spherical
  ! obstacle of radius 0.15 m centred at (0.5,0.5,0.5), handled by the
  ! cut-cell engine via subsampling + closure fragments. A 2 g
  ! TNT-equivalent charge is deposited off-centre so the blast waves
  ! reflect off the curved obstacle and the walls.
  init_type       = 'tnt_charge'
  blast_center    = 0.22, 0.5, 0.5
  blast_radius    = 0.07
  tnt_mass        = 0.002
  tnt_specific_E  = 4.184e6
  ambient_rho     = 1.225
  ambient_p       = 101325.0
  R_gas           = 287.05

  muscl_enabled   = .true.
  venkat_K        = 5.0
  viscous_enabled = .false.

  ! One sphere: kind=1, params = (cx, cy, cz, radius, -, -)
  n_shapes        = 1
  shape_kind(1)   = 1
  shape_param(:,1) = 0.5, 0.5, 0.5, 0.15, 0.0, 0.0

  patch_count   = 6
  patch_name(1) = 'x_min'
  patch_bc(1)   = 'slip_wall'
  patch_name(2) = 'x_max'
  patch_bc(2)   = 'slip_wall'
  patch_name(3) = 'y_min'
  patch_bc(3)   = 'slip_wall'
  patch_name(4) = 'y_max'
  patch_bc(4)   = 'slip_wall'
  patch_name(5) = 'z_min'
  patch_bc(5)   = 'slip_wall'
  patch_name(6) = 'z_max'
  patch_bc(6)   = 'slip_wall'
/
